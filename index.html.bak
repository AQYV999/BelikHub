  <div id="modal" class="modal-backdrop" role="dialog" aria-modal="true" aria-hidden="true"><div class="modal-card"><div id="modal-content"></div></div></div>
  <div id="toast" class="toast fixed bottom-5 left-1/2 z-[70] -translate-x-1/2 rounded-xl border border-forest bg-ink px-5 py-3 text-sm font-semibold text-white shadow-2xl" role="status"></div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
  <script type="module">
    import { initializeApp } from 'https://www.gstatic.com/firebasejs/11.4.0/firebase-app.js';
    import { getAuth, onAuthStateChanged, createUserWithEmailAndPassword, signInWithEmailAndPassword, signOut } from 'https://www.gstatic.com/firebasejs/11.4.0/firebase-auth.js';

    const siteHeader = document.getElementById('site-header');
    const syncHeader = () => { if (!siteHeader) return; siteHeader.classList.toggle('hero-nav', window.scrollY < 40); siteHeader.classList.toggle('nav-scrolled', window.scrollY >= 40); };
    syncHeader(); window.addEventListener('scroll', syncHeader, {passive:true});
    const $ = (s) => document.querySelector(s);
    const $$ = (s) => [...document.querySelectorAll(s)];
    const toast = (message) => { const el=$('#toast'); el.textContent=message; el.classList.add('show'); clearTimeout(window.toastTimer); window.toastTimer=setTimeout(()=>el.classList.remove('show'),3200); };

    const toggle=document.getElementById('menu-toggle');
    const closeMenu=document.getElementById('close-menu');
    const menu=document.getElementById('mobile-menu');
    if(toggle && menu) toggle.addEventListener('click',()=>{ menu.classList.remove('hidden'); document.body.style.overflow='hidden'; });
    if(closeMenu && menu) closeMenu.addEventListener('click',()=>{ menu.classList.add('hidden'); document.body.style.overflow='auto'; });
    document.querySelectorAll('.mobile-link').forEach(link => {
      link.addEventListener('click', () => { menu.classList.add('hidden'); document.body.style.overflow='auto'; });
    });

    $('#theme-toggle')?.addEventListener('click',()=>{
      const isDark = document.documentElement.classList.toggle('dark');
      $('#icon-moon')?.classList.toggle('hidden', isDark);
      $('#icon-sun')?.classList.toggle('hidden', !isDark);
      localStorage.setItem('belikhub-theme', isDark ? 'dark' : 'light');
    });

    const languageButton = $('#lang-toggle');
    const languageMenu = document.createElement('div');
    languageMenu.id = 'language-menu';
    languageMenu.className = 'absolute right-12 top-12 z-[80] w-36 border border-line bg-white p-1 text-ink shadow-xl';
    languageMenu.innerHTML = '<button data-language="id" class="block w-full px-3 py-2 text-left text-xs font-bold">Bahasa Indonesia</button><button data-language="en" class="block w-full px-3 py-2 text-left text-xs font-bold">English</button>';
    languageButton?.parentElement?.appendChild(languageMenu);
    if (languageButton?.parentElement) languageButton.parentElement.style.position = 'relative';

    const languageCopy = {
      id: {
        nav: ['Peta','Dashboard','Komunitas','Pulangkan Air','Belajar','Media'],
        monitor:'Mulai monitoring', join:'Gabung komunitas', dashboard:'Dampak yang bisa dilihat.', map:'Lihat kondisi mata air.', community:'Kontribusi kecil. Jejak yang terlihat.', points:'Cara dapat poin', returnWater:'Pulangkan air hujan ke rumahnya.', learn:'Belajar sebelum bergerak.', media:'Cerita dari lapangan.'
      },
      en: {
        nav: ['Map','Dashboard','Community','Return Water','Learn','Media'],
        monitor:'Start monitoring', join:'Join the community', dashboard:'Impact you can see.', map:'See the condition of our springs.', community:'Small contributions. Visible traces.', points:'How to earn points', returnWater:'Return rainwater to its source.', learn:'Learn before you act.', media:'Stories from the field.'
      }
    };

    const setLanguage = (lang) => {
      const c = languageCopy[lang] || languageCopy.id;
      document.documentElement.lang = lang === 'en' ? 'en' : 'id';
      document.title = lang === 'en' ? 'BelikHub — Community-Driven Water Restoration' : 'BelikHub — Pemulihan Sumber Air Berbasis Komunitas';
      if (languageButton) languageButton.textContent = lang.toUpperCase();
      const navLabels = {'#map': c.nav[0], '#dashboard': c.nav[1], '#community': c.nav[2], '#pulangkan-air': c.nav[3], '#learn': c.nav[4], '#media': c.nav[5]};
      document.querySelectorAll('header .mobile-link, header .lg\\:flex a').forEach(a => { const label = navLabels[a.getAttribute('href')]; if (label) a.textContent = label; });
      const set = (selector, value) => { const el=document.querySelector(selector); if (el) el.textContent=value; };
      set('#hero-monitor-text', c.monitor);
      set('#hero-join-text', c.join);
      set('#dashboard h2', c.dashboard);
      set('#map h2', c.map);
      set('#community h2', c.community);
      set('#points-text', c.points);
      set('#pulangkan-air h2', c.returnWater);
      set('#learn h2', c.learn);
      set('#media h2', c.media);
      localStorage.setItem('belikhub-language', lang);
      languageMenu.classList.remove('open');
    };

    languageButton?.addEventListener('click', (event) => { event.stopPropagation(); languageMenu.classList.toggle('open'); });
    languageMenu.querySelectorAll('[data-language]').forEach(button => button.addEventListener('click', () => { setLanguage(button.dataset.language); toast(button.dataset.language === 'en' ? 'Language changed to English.' : 'Bahasa diubah ke Indonesia.'); }));
    document.addEventListener('click', (event) => { if (!languageMenu.contains(event.target) && event.target !== languageButton) languageMenu.classList.remove('open'); });
    setLanguage(localStorage.getItem('belikhub-language') || 'id');

    let auth, currentUser = null;
    const loginBtn = $('#login-btn');
    const logoutBtn = $('#logout-btn');

    const updateAuthUI = (user) => {
      currentUser = user;
      loginBtn?.classList.toggle('hidden', !!user);
      logoutBtn?.classList.toggle('hidden', !user);
    };

    const apiRequest = async (path, payload, options = {}) => {
      const needsAuth = options.auth !== false;
      let token = null;
      if (needsAuth && currentUser) token = await currentUser.getIdToken();
      const headers = { 'Content-Type': 'application/json' };
      if (token) headers['Authorization'] = `Bearer ${token}`;
      const response = await fetch(path, { method: 'POST', headers, body: JSON.stringify(payload) });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || 'Request failed');
      return data;
    };

    const initFirebase = async () => {
      try {
        const cfg = await (await fetch('/api/firebase-config')).json();
        const app = initializeApp(cfg);
        auth = getAuth(app);
        onAuthStateChanged(auth, (user) => updateAuthUI(user));
      } catch (err) {
        console.error('Firebase init failed:', err);
      }
    };
    initFirebase();

    const modal = $('#modal'), modalContent = $('#modal-content');
    const closeModal = () => { modal.classList.remove('open'); modal.setAttribute('aria-hidden','true'); modalContent.innerHTML=''; };
    const openModal = (title, body) => {
      modalContent.innerHTML = `<div class="flex items-start justify-between border-b line p-6"><div><p class="eyebrow text-blue">BelikHub</p><h3 class="mt-2 font-display text-2xl font-bold">${title}</h3></div><button type="button" data-close-modal class="grid h-9 w-9 place-items-center rounded-xl border line text-xl">×</button></div><div class="p-6">${body}</div>`;
      modal.classList.add('open');
      modal.setAttribute('aria-hidden','false');
      modal.querySelector('[data-close-modal]')?.addEventListener('click', closeModal);
      const modalForm = modal.querySelector('form');
      if (modalForm && !modalForm.dataset.api && !modalForm.dataset.custom) {
        modalForm.addEventListener('submit', e => { e.preventDefault(); closeModal(); toast('Permintaan berhasil dicatat di prototipe BelikHub.'); });
      }
    };
    modal?.addEventListener('click', e => { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

    const reportForm = (name, points) => `<form id="report-form" data-api="reports"><p class="text-sm leading-6 muted">Lengkapi laporan ${name.toLowerCase()} untuk mendapatkan <b>${points} poin</b>. Data ini akan diteruskan ke tim verifikasi.</p><label class="mt-5 block text-sm font-semibold">Nama lokasi<input required placeholder="Nama mata air / desa" class="mt-2" /></label><label class="mt-4 block text-sm font-semibold">Catatan lapangan<textarea required rows="3" placeholder="Apa yang Anda temukan?" class="mt-2"></textarea></label><button class="aqua-gradient mt-5 w-full rounded-xl px-4 py-3 font-bold text-white transition hover:brightness-110">Kirim laporan</button></form>`;

    $$('[data-toast]').forEach(el => el.addEventListener('click', e => {
      e.preventDefault();
      openModal('Mulai kontribusi', `<form><p class="text-sm leading-6 muted">${el.dataset.toast}</p><label class="mt-5 block text-sm font-semibold">Email<input required type="email" placeholder="nama@email.com" class="mt-2" /></label><button class="aqua-gradient mt-5 w-full rounded-xl px-4 py-3 font-bold text-white transition hover:brightness-110">Lanjutkan</button></form>`);
    }));

    $$('.report-card').forEach(el => el.addEventListener('click', () => {
      openModal(el.dataset.report, reportForm(el.dataset.report, el.textContent.match(/\+[\d.]+/)?.[0] || '100'));
      $('#report-form')?.addEventListener('submit', async e => {
        e.preventDefault();
        const form = e.currentTarget;
        const submit = form.querySelector('button');
        submit.disabled = true;
        submit.textContent = 'Menyimpan…';
        try {
          const data = await apiRequest('/api/reports', {
            reportType: el.dataset.report,
            location: form.querySelector('input').value,
            notes: form.querySelector('textarea').value
          }, { auth: true });
          closeModal();
          toast(`Laporan tersimpan. +${data.points} poin setelah verifikasi.`);
        } catch (error) {
          submit.disabled = false;
          submit.textContent = 'Kirim laporan';
          toast(error.message);
        }
      });
    }));

    $('#points-btn')?.addEventListener('click', () => openModal('Cara mendapatkan poin', '<div class="divide-y line text-sm"><div class="flex justify-between py-3"><span>Survei Mata Air</span><b class="text-forest">+100 pts</b></div><div class="flex justify-between py-3"><span>Restorasi Mata Air</span><b class="text-forest">+1.000 pts</b></div><div class="flex justify-between py-3"><span>Pembangunan Rorak</span><b class="text-forest">+500 pts</b></div><div class="flex justify-between py-3"><span>Penanaman Pohon</span><b class="text-forest">+100 pts</b></div></div><p class="mt-5 text-xs leading-relaxed muted">Setelah mencapai 20.000 poin, Anda dapat mengajukan proyek komunitas untuk ditinjau admin.</p>'));

    $('#partner-form')?.addEventListener('submit', async e => {
      e.preventDefault();
      const form = e.currentTarget;
      const submit = form.querySelector('button');
      const data = new FormData(form);
      submit.disabled = true;
      submit.textContent = 'Mengirim…';
      try {
        await apiRequest('/api/partnerships', {
          name: data.get('name'),
          institution: data.get('institution'),
          need: data.get('need'),
          email: data.get('email')
        }, { auth: false });
        $('#partner-note').textContent = 'Permintaan tersimpan. Tim BelikHub akan menghubungi Anda.';
        toast('Permintaan kemitraan berhasil disimpan.');
        form.reset();
      } catch (error) {
        toast(error.message);
      } finally {
        submit.disabled = false;
        submit.textContent = 'Kirim minat kemitraan';
      }
    });

    $('#newsletter')?.addEventListener('submit', e => { e.preventDefault(); toast('Anda sudah masuk daftar pembaruan BelikHub.'); e.target.reset(); });

    $$('.learn-tab').forEach(tab => tab.addEventListener('click', () => {
      $$('.learn-tab').forEach(t => { t.classList.remove('tab-active'); t.classList.add('text-slate-400'); });
      tab.classList.add('tab-active'); tab.classList.remove('text-slate-400');
      $('#courses').classList.toggle('hidden', tab.dataset.tab !== 'courses');
      $('#readings').classList.toggle('hidden', tab.dataset.tab !== 'readings');
    }));

    const points = [{name:'Tuk Bismo',lat:-7.02,lng:109.91,status:'healthy'},{name:'Belik Soka',lat:-8.01,lng:110.61,status:'restored'},{name:'Wonomerto',lat:-7.29,lng:110.09,status:'attention'},{name:'Rowo Santen',lat:-7.91,lng:110.34,status:'healthy'},{name:'Watulumbung',lat:-7.23,lng:109.91,status:'restored'}];
    if(window.L){
      const map=L.map('map-canvas',{scrollWheelZoom:true}).setView([-7.35,110.2],7);
      window.belikhubMap=map;
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
      }).addTo(map);
      setTimeout(()=>{ window.belikhubMap?.invalidateSize(); },500);
      window.addEventListener('resize',()=>{ window.belikhubMap?.invalidateSize(); });
      let markers=[];
      const renderMarkers=(filter='all',query='')=>{markers.forEach(m=>m.remove());markers=points.filter(p=>(filter==='all'||p.status===filter)&&p.name.toLowerCase().includes(query.toLowerCase())).map(p=>{const color=p.status==='healthy'?'#2BB3C0':p.status==='restored'?'#0E7C86':'#f59e0b';const icon=L.divIcon({className:'custom-pin',html:`<span style="display:block;width:16px;height:16px;border-radius:50%;background:${color};border:3px solid white;box-shadow:0 1px 5px #333"></span>`,iconSize:[16,16],iconAnchor:[8,8]});return L.marker([p.lat,p.lng],{icon}).addTo(map).bindPopup(`<b>${p.name}</b><br><span style="font-size:14px">Status: ${p.status}</span>`);});};
      renderMarkers();
      $('#map-filter')?.addEventListener('change',e=>renderMarkers(e.target.value,$('#map-search').value));
      $('#map-search')?.addEventListener('input',e=>renderMarkers($('#map-filter').value,e.target.value));
      $('#locate-btn')?.addEventListener('click',()=>{if(!navigator.geolocation){toast('Browser tidak mendukung lokasi.');return;}toast('Meminta izin lokasi…');navigator.geolocation.getCurrentPosition(pos=>{const {latitude,longitude}=pos.coords;window.belikhubMap?.setView([latitude,longitude],12);toast('Peta dipusatkan ke lokasi Anda.');},()=>toast('Lokasi tidak tersedia atau izin ditolak.'));});
    }

    $('#load-reports')?.addEventListener('click', e => { e.currentTarget.textContent='Semua laporan sudah dimuat'; toast('24 laporan tambahan dimuat.'); openModal('Laporan komunitas','<div class="divide-y line text-sm"><div class="py-3"><b>Survei Mata Air</b><span class="ml-3 muted">Tuk Bismo · 04 Nov 2026</span></div><div class="py-3"><b>Restorasi</b><span class="ml-3 muted">Rowo Santen · 18 Okt 2026</span></div><div class="py-3"><b>Survei Mata Air</b><span class="ml-3 muted">Wonomerto · 12 Okt 2026</span></div></div>'); });

    const openLogin = (e) => {
      e.preventDefault();
      menu?.classList.add('hidden'); document.body.style.overflow='auto';
      openModal('Masuk', `
        <form id="login-form" data-custom="1">
          <label class="block text-sm font-semibold">Email<input required type="email" name="email" placeholder="nama@email.com" class="mt-2" /></label>
          <label class="mt-4 block text-sm font-semibold">Password<input name="password" required minlength="6" type="password" placeholder="••••••••" class="mt-2" /></label>
          <button class="aqua-gradient mt-5 w-full rounded-xl px-4 py-3 font-bold text-white transition hover:brightness-110" type="submit">Masuk</button>
          <button id="register-btn" class="mt-3 w-full rounded-xl border border-line px-4 py-3 font-bold transition-colors hover:bg-slate-50/10" type="button">Daftar akun baru</button>
        </form>
      `);
      const form = modal.querySelector('#login-form');
      const run = async (fn, label, btn) => {
        if (!auth) { toast('Firebase belum siap. Cek konfigurasi .env dan /api/firebase-config.'); return; }
        const data = new FormData(form);
        if (!form.reportValidity()) return;
        btn.disabled = true; btn.textContent = '…';
        try {
          const cred = await fn(auth, data.get('email'), data.get('password'));
          closeModal();
          toast(`Selamat datang, ${cred.user.displayName || cred.user.email.split('@')[0]}.`);
        } catch (error) {
          btn.disabled = false; btn.textContent = label;
          toast(error.code === 'auth/invalid-credential' || error.code === 'auth/user-not-found' ? 'Email/password salah, atau akun belum terdaftar.' : error.message);
        }
      };
      form.addEventListener('submit', ev => { ev.preventDefault(); run(signInWithEmailAndPassword, 'Masuk', form.querySelector('[type=submit]')); });
      form.querySelector('#register-btn').addEventListener('click', ev => run(createUserWithEmailAndPassword, 'Daftar akun baru', ev.currentTarget));
    };
    $('#login-btn')?.addEventListener('click', openLogin);
    $('#login-btn-mobile')?.addEventListener('click', openLogin);

    logoutBtn?.addEventListener('click', async () => {
      try { await signOut(auth); toast('Anda telah keluar.'); } catch (error) { toast(error.message); }
    });

    if (localStorage.getItem('belikhub-theme') === 'dark') {
      document.documentElement.classList.add('dark');
      $('#icon-moon')?.classList.add('hidden');
      $('#icon-sun')?.classList.remove('hidden');
    }
  </script>
</body>
</html>