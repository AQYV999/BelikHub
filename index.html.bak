<!doctype html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="BelikHub — platform komunitas untuk memantau, memulihkan, dan menjaga mata air Indonesia." />
  <title>BelikHub — Community-Driven Water Restoration</title>
  <link rel="icon" type="image/webp" href="/icons/logo.webp" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
  <link rel="stylesheet" type="text/css" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans:['DM Sans','sans-serif'], display:['Manrope','sans-serif'], mono:['DM Mono','monospace'] },
          colors:{
            ink:'#0B2A33',
            forest:'#0E7C86',
            aqua:'#2BB3C0',
            blue:'#0B8DA0',
            lime:'#FFD166',
            paper:'#F4FBFC',
            line:'#D5E8EC'
          },
          boxShadow: { soft:'0 10px 40px -12px rgba(14,124,134,.18)', hover:'0 22px 44px -12px rgba(14,124,134,.28)' },
          borderRadius: { xl:'1rem', '2xl':'1.5rem', '3xl':'2rem' }
        }
      }
    };
  </script>
  <style>
    /* =====================================================
       TEMA — Mata Air Jernih (terang + gelap)
       ===================================================== */
    :root{
      color-scheme:light;
      --bg:#F4FBFC; --card:#FFFFFF; --border:#D5E8EC;
      --teks:#0B2A33; --teks-lembut:#456872;
      --panel:#FFFFFF; --panel-border:#D5E8EC; --panel-atribusi:rgba(255,255,255,.92);
      --link:#0B8DA0;
      --font-dasar:16px; --font-legend:15px; --font-popup:15px; --font-atribusi:12px;
    }
    .dark{
      color-scheme:dark;
      --bg:#071A20; --card:#0F2A33; --border:#1D4651;
      --teks:#E6F6F8; --teks-lembut:#9CC3CB;
      --panel:#0F2A33; --panel-border:#1D4651; --panel-atribusi:rgba(15,42,51,.92);
      --link:#5FD3E0;
    }

    *{box-sizing:border-box}
    html{font-size:var(--font-dasar)}
    body{background:var(--bg);color:var(--teks);font-size:1rem;line-height:1.55;-webkit-font-smoothing:antialiased}
    .display{font-family:Manrope,sans-serif;letter-spacing:-.055em}
    .eyebrow{font:500 11px/1.2 'DM Mono',monospace;letter-spacing:.12em;text-transform:uppercase}
    .muted{color:var(--teks-lembut)}

    .dark .bg-white,.dark .card{background:var(--card)!important;border-color:var(--border)!important}
    .dark .bg-paper{background:var(--bg)}
    .dark .text-ink{color:var(--teks)}
    .dark .text-ink\/70{color:var(--teks-lembut)}
    .dark .text-slate-400,.dark .text-slate-500,.dark .text-slate-600{color:var(--teks-lembut)}
    .dark .border-line,.dark .line{border-color:var(--border)}
    .dark input,.dark select,.dark textarea{background:#0B2229;color:var(--teks);border-color:var(--border)}
    .dark #kemitraan{background:#0A222A}
    .dark .grid-paper{background-color:#0A222A}
    .line{border-color:var(--border)}
    .card{border:1px solid var(--border);background:var(--card)}
    .soft-card{border:1px solid var(--border);background:var(--card);border-radius:1.5rem;box-shadow:0 10px 40px -14px rgba(14,124,134,.14);transition:transform .25s,box-shadow .25s}
    .soft-card:hover{transform:translateY(-3px);box-shadow:0 22px 44px -14px rgba(14,124,134,.26)}

    .aqua-gradient{background:linear-gradient(135deg,#0E7C86,#2BB3C0)}
    .text-gradient{background:linear-gradient(90deg,#FFD166,#8FE3EC);-webkit-background-clip:text;background-clip:text;color:transparent}
    .grid-paper{background-color:#E6F5F7;background-image:linear-gradient(rgba(14,124,134,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(14,124,134,.07) 1px,transparent 1px);background-size:28px 28px}
    .dot{width:10px;height:10px;border-radius:999px;display:inline-block}
    .tab-active{color:#0E7C86;border-bottom:2px solid #0E7C86}
    .dark .tab-active{color:#5FD3E0;border-color:#5FD3E0}
    .map-height{height:540px}

    @keyframes fade-up{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
    .animate-fade-up{animation:fade-up .8s ease both}

    #site-header{transition:background .3s,border-color .3s,box-shadow .3s}
    #site-header.hero-nav{background:transparent;border-color:transparent}
    #site-header.hero-nav .brand-text{color:#fff}
    #site-header.hero-nav .brand-accent{color:#FFD166}
    #site-header.hero-nav .nav-ghost{color:#fff}
    #site-header.nav-scrolled{background:rgba(244,251,252,.82);backdrop-filter:blur(18px);border-color:var(--border);box-shadow:0 8px 30px -18px rgba(14,124,134,.35)}
    #site-header.nav-scrolled .brand-text{color:var(--teks)}
    #site-header.nav-scrolled .brand-accent{color:#0E7C86}
    #site-header.nav-scrolled .nav-ghost{color:var(--teks)}
    .dark #site-header.nav-scrolled{background:rgba(7,26,32,.85)}
    .dark #site-header.nav-scrolled .brand-accent{color:#5FD3E0}
    .nav-pill{background:rgba(255,255,255,.72);backdrop-filter:blur(14px);border:1px solid var(--border)}
    .dark .nav-pill{background:rgba(15,42,51,.8)}
    .nav-link{color:var(--teks);opacity:.85;transition:color .2s,opacity .2s}
    .nav-link:hover{color:#0E7C86;opacity:1}
    .dark .nav-link:hover{color:#5FD3E0}
    .nav-btn{background:var(--card);border:1px solid var(--border);color:var(--teks)}
    .nav-btn:hover{background:var(--bg)}

    .modal-backdrop{position:fixed;inset:0;z-index:90;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(4,22,28,.7);backdrop-filter:blur(5px)}
    .modal-backdrop.open{display:flex}
    .modal-card{width:min(100%,520px);max-height:90vh;overflow:auto;background:var(--card);color:var(--teks);border-radius:1.5rem;box-shadow:0 24px 80px rgba(0,0,0,.28)}
    .modal-card input,.modal-card textarea,.modal-card select{width:100%;border:1px solid var(--border);border-radius:.75rem;padding:12px;outline:none;background:transparent;color:inherit}
    .modal-card input:focus,.modal-card textarea:focus,.modal-card select:focus{border-color:#0E7C86}
    .toast{transform:translateY(20px);opacity:0;pointer-events:none;transition:.25s}
    .toast.show{transform:translateY(0);opacity:1;pointer-events:auto}

    #language-menu{display:none!important;z-index:100!important;color:#0B2A33!important;background:#fff!important;border-radius:.75rem}
    #language-menu.open{display:block!important}
    #language-menu button{color:#0B2A33!important;background:#fff!important;border-radius:.5rem}
    #language-menu button:hover{background:#E6F5F7!important}

    .leaflet-container{font-family:'DM Sans',sans-serif}
    .leaflet-popup-content-wrapper{background:var(--panel)!important;color:var(--teks)!important;border-radius:12px}
    .leaflet-popup-content{font-size:var(--font-popup)!important;line-height:1.55!important;margin:12px 16px!important}
    .leaflet-popup-tip{background:var(--panel)!important}
    .leaflet-control-attribution{font-size:var(--font-atribusi)!important;background:var(--panel-atribusi)!important;color:var(--teks-lembut)!important}
    .leaflet-control-attribution a{color:var(--link)!important}
    .map-legend{font-size:var(--font-legend);color:var(--teks)}
    #load-reports{font-size:var(--font-legend);color:var(--teks)}
  </style>
</head>
<body class="overflow-x-hidden">
  <header id="site-header" class="fixed inset-x-0 top-0 z-50 border-b border-transparent">
    <nav class="mx-auto flex h-[72px] max-w-[1280px] items-center justify-between gap-6 px-5 lg:px-8" aria-label="Navigasi utama">
      <a href="#top" class="group flex shrink-0 items-center gap-2.5">
        <span class="aqua-gradient grid h-10 w-10 place-items-center overflow-hidden rounded-xl shadow-sm transition-transform group-hover:scale-105">
          <i class="ph ph-drop text-2xl text-white"></i>
        </span>
        <span class="brand-text font-display text-xl font-extrabold tracking-tight">Belik<span class="brand-accent">Hub</span></span>
      </a>

      <div class="nav-pill hidden items-center gap-8 rounded-2xl px-6 py-2.5 shadow-sm lg:flex">
        <a href="#map" class="nav-link text-sm font-semibold">Map</a>
        <a href="#dashboard" class="nav-link text-sm font-semibold">Dashboard</a>
        <a href="#community" class="nav-link text-sm font-semibold">Community</a>
        <a href="#pulangkan-air" class="nav-link text-sm font-semibold">Pulangkan Air</a>
        <a href="#learn" class="nav-link text-sm font-semibold">Learn</a>
      </div>

      <div class="hidden items-center gap-3 md:flex">
        <button id="lang-toggle" class="nav-btn flex h-10 items-center justify-center rounded-xl px-3 text-xs font-bold transition-colors">ID</button>
        <button id="theme-toggle" class="nav-btn flex h-10 w-10 items-center justify-center rounded-xl transition-colors" aria-label="Ganti tema">
          <img id="icon-moon" src="/icons/moon.webp" alt="Dark Mode" class="h-5 w-5 object-contain" />
          <img id="icon-sun" src="/icons/sun.webp" alt="Light Mode" class="hidden h-5 w-5 object-contain" />
        </button>
        <a href="#" id="login-btn" class="nav-ghost rounded-xl px-5 py-2.5 text-sm font-bold transition-colors hover:opacity-80">Masuk</a>
        <button id="logout-btn" class="nav-ghost hidden rounded-xl px-5 py-2.5 text-sm font-bold transition-colors hover:opacity-80">Keluar</button>
        <a href="#kemitraan" class="aqua-gradient rounded-xl px-5 py-2.5 text-sm font-bold text-white shadow-sm transition-all hover:shadow-hover hover:brightness-110">Join now</a>
      </div>

      <button id="menu-toggle" class="nav-btn grid h-10 w-10 place-items-center rounded-xl shadow-sm md:hidden" aria-label="Buka menu">
        <i class="ph ph-list text-xl"></i>
      </button>
    </nav>

    <div id="mobile-menu" class="fixed inset-0 z-[60] hidden bg-ink/95 backdrop-blur-xl transition-opacity md:hidden">
      <div class="flex h-full flex-col px-6 py-6">
        <div class="mb-10 flex items-center justify-between">
          <span class="font-display text-2xl font-extrabold text-white">Belik<span class="text-lime">Hub</span></span>
          <button id="close-menu" class="grid h-10 w-10 place-items-center rounded-xl bg-white/10 text-white hover:bg-white/20" aria-label="Tutup menu">
            <i class="ph ph-x text-xl"></i>
          </button>
        </div>
        <div class="flex flex-col gap-6 font-display text-2xl font-bold text-white">
          <a href="#map" class="mobile-link transition-colors hover:text-lime">Map</a>
          <a href="#dashboard" class="mobile-link transition-colors hover:text-lime">Dashboard</a>
          <a href="#community" class="mobile-link transition-colors hover:text-lime">Community</a>
          <a href="#pulangkan-air" class="mobile-link transition-colors hover:text-lime">Pulangkan Air</a>
          <a href="#learn" class="mobile-link transition-colors hover:text-lime">Learn</a>
          <a href="#media" class="mobile-link transition-colors hover:text-lime">Media</a>
        </div>
        <div class="mt-auto flex flex-col gap-3">
          <a href="#" id="login-btn-mobile" class="flex w-full items-center justify-center rounded-xl border border-white/20 bg-white/10 py-4 text-center text-sm font-bold text-white hover:bg-white/20">Masuk</a>
          <a href="#kemitraan" class="mobile-link flex w-full items-center justify-center rounded-xl bg-lime py-4 text-center text-sm font-bold text-ink hover:bg-white">Join now</a>
        </div>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="relative flex min-h-[100svh] items-center overflow-hidden bg-ink pt-20">
      <video autoplay loop muted playsinline preload="metadata" class="absolute inset-0 h-full w-full object-cover opacity-60">
        <source src="https://cdn.coverr.co/videos/coverr-waterfall-in-the-forest-9382/1080p.mp4" type="video/mp4">
      </video>
      <div class="absolute inset-0 bg-gradient-to-r from-[#062830]/90 via-[#0E7C86]/45 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[#F4FBFC]/20 to-transparent"></div>

      <div class="relative z-10 mx-auto w-full max-w-[1280px] px-5 py-20 lg:px-8">
        <div class="animate-fade-up max-w-3xl">
          <div class="mb-8 inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 backdrop-blur-md">
            <span class="flex h-2 w-2 animate-pulse rounded-full bg-lime"></span>
            <p class="font-mono text-xs uppercase tracking-widest text-white">Community-driven restoration</p>
          </div>

          <h1 class="mb-6 font-display text-5xl font-extrabold leading-[1.1] tracking-tighter text-white md:text-7xl lg:text-8xl" style="font-size:revert-layer">
            Air yang hidup.<br>
            <span class="text-gradient">Komunitas yang bergerak.</span>
          </h1>

          <p class="mb-10 max-w-xl text-lg leading-relaxed text-white/80 md:text-xl">
            Pantau mata air, ikut memulihkan ekosistemnya, dan lihat kontribusi komunitas tumbuh dalam satu ruang terbuka.
          </p>

          <div class="flex flex-col gap-4 sm:flex-row">
            <a href="#map" class="inline-flex items-center justify-center gap-2 rounded-xl bg-lime px-8 py-4 text-sm font-bold text-ink transition-all hover:scale-105 hover:bg-lime/90">
              <span id="hero-monitor-text">Mulai monitoring</span> <i class="ph ph-arrow-right text-lg"></i>
            </a>
            <a href="#community" class="inline-flex items-center justify-center rounded-xl border border-white/40 bg-white/10 px-8 py-4 text-sm font-bold text-white backdrop-blur-md transition-all hover:bg-white hover:text-ink">
              <span id="hero-join-text">Gabung komunitas</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="dashboard" class="border-y border-line bg-white py-20 lg:py-32">
      <div class="mx-auto max-w-[1280px] px-5 lg:px-8">
        <div class="mb-12 text-center">
          <p class="eyebrow text-blue">Real-time impact</p>
          <h2 class="display mt-4 text-4xl font-extrabold leading-[1.1] tracking-tighter sm:text-5xl">Dampak yang bisa dilihat.</h2>
          <p class="mx-auto mt-5 max-w-2xl leading-relaxed text-ink/70">Setiap laporan lapangan menjadi bagian dari gambaran yang lebih besar tentang pemulihan air di Indonesia.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div class="soft-card p-7">
            <span class="aqua-gradient mb-4 grid h-10 w-10 place-items-center rounded-xl text-white"><i class="ph ph-binoculars text-xl"></i></span>
            <p class="eyebrow text-slate-400">Monitored springs</p>
            <p class="display mt-3 text-5xl font-extrabold leading-[1.1] tracking-tighter text-blue">500<span class="text-2xl">+</span></p>
            <p class="mt-2 text-sm leading-relaxed text-ink/70">mata air terpantau komunitas</p>
          </div>
          <div class="soft-card p-7">
            <span class="aqua-gradient mb-4 grid h-10 w-10 place-items-center rounded-xl text-white"><i class="ph ph-drop text-xl"></i></span>
            <p class="eyebrow text-slate-400">Restored springs</p>
            <p class="display mt-3 text-5xl font-extrabold leading-[1.1] tracking-tighter text-forest">30<span class="text-2xl">+</span></p>
            <p class="mt-2 text-sm leading-relaxed text-ink/70">lokasi dengan tindakan pemulihan</p>
          </div>
          <div class="soft-card p-7">
            <span class="aqua-gradient mb-4 grid h-10 w-10 place-items-center rounded-xl text-white"><i class="ph ph-tree text-xl"></i></span>
            <p class="eyebrow text-slate-400">Native trees</p>
            <p class="display mt-3 text-5xl font-extrabold leading-[1.1] tracking-tighter text-forest">20k<span class="text-2xl">+</span></p>
            <p class="mt-2 text-sm leading-relaxed text-ink/70">pohon endemik ditanam</p>
          </div>
          <div class="soft-card p-7">
            <span class="aqua-gradient mb-4 grid h-10 w-10 place-items-center rounded-xl text-white"><i class="ph ph-stack text-xl"></i></span>
            <p class="eyebrow text-slate-400">Infiltration pits</p>
            <p class="display mt-3 text-5xl font-extrabold leading-[1.1] tracking-tighter text-forest">200<span class="text-2xl">+</span></p>
            <p class="mt-2 text-sm leading-relaxed text-ink/70">rorak untuk recharge air tanah</p>
          </div>
        </div>
        <div class="mt-10 grid gap-6 lg:grid-cols-2">
          <div class="soft-card p-6">
            <div class="flex items-center justify-between">
              <h3 class="font-display text-xl font-bold leading-[1.1] tracking-tighter">Aktivitas bulanan</h3>
              <button class="flex items-center gap-1 text-xs font-bold text-blue">Lihat arsip <i class="ph ph-arrow-up-right"></i></button>
            </div>
            <div class="mt-6 space-y-4">
              <div class="flex items-center justify-between text-sm leading-relaxed text-ink/70">
                <span class="flex items-center gap-3"><span class="dot bg-aqua"></span>Survei Mata Air</span>
                <b class="text-forest">42</b>
              </div>
              <div class="flex items-center justify-between text-sm leading-relaxed text-ink/70">
                <span class="flex items-center gap-3"><span class="dot bg-forest"></span>Penanaman Pohon</span>
                <b class="text-forest">18</b>
              </div>
              <div class="flex items-center justify-between text-sm leading-relaxed text-ink/70">
                <span class="flex items-center gap-3"><span class="dot bg-orange-400"></span>Pembangunan Rorak</span>
                <b class="text-forest">7</b>
              </div>
            </div>
          </div>
          <div class="soft-card p-6">
            <div class="flex items-center justify-between">
              <h3 class="font-display text-xl font-bold leading-[1.1] tracking-tighter">Aktivitas terbaru</h3>
              <button class="flex items-center gap-1 text-xs font-bold text-blue">Semua laporan <i class="ph ph-arrow-up-right"></i></button>
            </div>
            <div class="mt-6 space-y-4">
              <div class="flex items-center justify-between text-sm leading-relaxed text-ink/70">
                <span class="flex items-center gap-3"><span class="dot bg-lime"></span>Tuk Bismo</span>
                <span class="text-slate-400">04 Nov</span>
              </div>
              <div class="flex items-center justify-between text-sm leading-relaxed text-ink/70">
                <span class="flex items-center gap-3"><span class="dot bg-forest"></span>Rowo Santen</span>
                <span class="text-slate-400">18 Okt</span>
              </div>
              <div class="flex items-center justify-between text-sm leading-relaxed text-ink/70">
                <span class="flex items-center gap-3"><span class="dot bg-aqua"></span>Wonomerto</span>
                <span class="text-slate-400">12 Okt</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="map" class="py-20 lg:py-32">
      <div class="mx-auto max-w-[1280px] px-5 lg:px-8">
        <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <div>
            <p class="eyebrow text-blue">Interactive spring map</p>
            <h2 class="display mt-4 text-4xl font-extrabold leading-[1.1] tracking-tighter sm:text-5xl">Lihat kondisi mata air.</h2>
            <p class="muted mt-4 max-w-2xl leading-relaxed">Jelajahi titik yang dipantau komunitas. Lokasi publik disamarkan dalam radius 5 km untuk menjaga keamanan sumber air.</p>
          </div>
          <button id="locate-btn" class="nav-btn inline-flex items-center self-start rounded-xl px-4 py-3 text-sm font-bold transition-colors md:self-auto">
            <i class="ph ph-crosshair mr-2 text-lg text-blue"></i>Gunakan lokasi saya
          </button>
        </div>
        <div class="soft-card mt-8 overflow-hidden">
          <div class="flex flex-col gap-3 border-b border-line p-4 sm:flex-row">
            <div class="relative flex-1">
              <i class="ph ph-magnifying-glass absolute left-3 top-3.5 text-lg text-slate-400"></i>
              <input id="map-search" type="search" placeholder="Cari mata air, desa, provinsi..." class="w-full rounded-xl border border-line bg-transparent py-3 pl-10 pr-4 text-sm outline-none focus:border-forest" />
            </div>
            <select id="map-filter" class="rounded-xl border border-line bg-transparent px-4 py-3 text-sm outline-none focus:border-forest">
              <option value="all">Semua titik</option>
              <option value="healthy">Sehat</option>
              <option value="restored">Dipulihkan</option>
              <option value="attention">Perlu perhatian</option>
            </select>
          </div>
          <div id="map-canvas" class="map-height"></div>
          <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line p-4 text-[12px] leading-relaxed">
            <span class="map-legend flex items-center gap-4">
              <span class="flex items-center gap-2"><i class="dot bg-aqua"></i>Sehat</span>
              <span class="flex items-center gap-2"><i class="dot bg-forest"></i>Dipulihkan</span>
              <span class="flex items-center gap-2"><i class="dot bg-orange-400"></i>Perhatian</span>
            </span>
            <button id="load-reports" class="flex items-center gap-2 font-bold">Muat laporan (24/431) <i class="ph ph-arrow-down"></i></button>
          </div>
        </div>
      </div>
    </section>

    <section id="community" class="bg-ink py-20 text-white lg:py-32" style="background-image:radial-gradient(circle at 85% 10%,rgba(43,179,192,.28),transparent 45%)">
      <div class="mx-auto max-w-[1280px] px-5 lg:px-8">
        <div class="grid gap-14 lg:grid-cols-[.75fr_1.25fr]">
          <div>
            <p class="eyebrow text-lime">Community activity</p>
            <h2 class="display mt-5 text-4xl font-extrabold leading-[1.1] tracking-tighter sm:text-5xl">Kontribusi kecil. Jejak yang terlihat.</h2>
            <p class="mt-5 leading-relaxed text-white/70">Isi formulir ringan dari browser, kumpulkan poin, dan bantu tim lapangan memahami kondisi mata air secara berkala.</p>
            <button id="points-btn" class="mt-8 flex items-center gap-2 rounded-xl border border-white/30 px-4 py-3 text-sm font-bold transition hover:bg-white hover:text-ink"><span id="points-text">Cara dapat poin</span> <i class="ph ph-arrow-up-right text-lg"></i></button>
          </div>
          <div>
            <div class="grid gap-3 sm:grid-cols-2">
              <button data-report="Survei Mata Air" class="report-card flex flex-col items-start justify-between rounded-2xl border border-white/15 bg-white/5 p-5 text-left transition hover:-translate-y-0.5 hover:bg-white/10">
                <span><img src="/icons/water-drop.webp" alt="Survei Mata Air" class="mb-3 h-8 w-8 object-contain drop-shadow-sm" /><strong class="block">Survei Mata Air</strong><small class="mt-1 block text-white/60">Cek kondisi dan debit</small></span>
                <b class="text-lime">+100</b>
              </button>
              <button data-report="Restorasi Mata Air" class="report-card flex flex-col items-start justify-between rounded-2xl border border-white/15 bg-white/5 p-5 text-left transition hover:-translate-y-0.5 hover:bg-white/10">
                <span><img src="/icons/shovel.webp" alt="Restorasi" class="mb-3 h-8 w-8 object-contain drop-shadow-sm" /><strong class="block">Restorasi</strong><small class="mt-1 block text-white/60">Laporkan pekerjaan lapangan</small></span>
                <b class="text-lime">+1.000</b>
              </button>
              <button data-report="Penanaman Pohon" class="report-card flex flex-col items-start justify-between rounded-2xl border border-white/15 bg-white/5 p-5 text-left transition hover:-translate-y-0.5 hover:bg-white/10">
                <span><img src="/icons/tree.webp" alt="Tanam Pohon" class="mb-3 h-8 w-8 object-contain drop-shadow-sm" /><strong class="block">Tanam Pohon</strong><small class="mt-1 block text-white/60">Catat bibit yang ditanam</small></span>
                <b class="text-lime">+100</b>
              </button>
              <button data-report="Pembangunan Rorak" class="report-card flex flex-col items-start justify-between rounded-2xl border border-white/15 bg-white/5 p-5 text-left transition hover:-translate-y-0.5 hover:bg-white/10">
                <span><img src="/icons/rorak.webp" alt="Bangun Rorak" class="mb-3 h-8 w-8 object-contain drop-shadow-sm" /><strong class="block">Bangun Rorak</strong><small class="mt-1 block text-white/60">Salurkan air hujan ke tanah</small></span>
                <b class="text-lime">+500</b>
              </button>
            </div>
          </div>
        </div>
      </div>
