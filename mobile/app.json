{
  "expo": {
    "name": "BelikHub",
    "slug": "belikhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "belikhub",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#124734"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.belikhub.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#124734"
      },
      "package": "id.belikhub.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a4ecb5c0-1433-4b4e-9f16-3bb5eb978ccc"
      }
    },
    "owner": "faweezx"
  }
}
